{
    "settings": {
        "analysis": {
            "analyzer": {
                "custom_analyzer": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase"
                    ]
                }
            }
        },
        "number_of_shards": 6,
        "number_of_replicas": 0,
        "refresh_interval": "-1"
    },
    "mappings": {
        "properties": {
            "id": {
                "type": "keyword"
            },
            "title": {
                "type": "text",
                "analyzer": "custom_analyzer",
                "fields": {
                    "raw": {
                        "type": "keyword"
                    }
                }
            },
            "text": {
                "type": "text",
                "analyzer": "custom_analyzer"
            },
            "url": {
                "type": "keyword",
                "index": false
            },
            "wiki_id": {
                "type": "long"
            },
            "views": {
                "type": "float"
            },
            "paragraph_id": {
                "type": "integer"
            },
            "langs": {
                "type": "integer"
            },
            "vector": {
                "type": "dense_vector",
                "dims": 1024,
                "index": true,
                "similarity": "cosine",
                "index_options": {
                    "type": "bbq_hnsw",
                    "m": 32,
                    "ef_construction": 200
                }
            }
        }
    }
}
